# Copy to .env (never committed) and fill in what the task needs.

# Hugging Face (optional; public repos download without it, a token raises rate limits)
HF_TOKEN=

# NVIDIA NGC API key for RIM/OCSP services (gate G-NGC)
NGC_API_KEY=

# Intel PCS API key, bare-metal hosts only (gate G-INTEL-PCS)
INTEL_PCS_API_KEY=

# Dedicated key for your node, used by the provider checker (not a TR customer key).
# Never give the node a customer key, payment credential or accounting database.
TR_PROVIDER_API_KEY=

# GCP lab project (gate G-GCP-PROJECT); never the production project
GCP_PROJECT=
GCP_REGION=
GCP_ZONE=
