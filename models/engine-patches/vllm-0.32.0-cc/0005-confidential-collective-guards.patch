diff --git a/vllm/v1/conf_compute_utils.py b/vllm/v1/conf_compute_utils.py
--- a/vllm/v1/conf_compute_utils.py
+++ b/vllm/v1/conf_compute_utils.py
@@ -29,6 +29,19 @@
     from vllm.platforms import current_platform

     return current_platform.is_confidential_compute()
+
+
+def confidential_collectives_selected() -> bool:
+    """Strict software selection for collective guards, never attestation."""
+    try:
+        from vllm.platforms import current_platform
+
+        selected = current_platform.is_confidential_compute()
+        if type(selected) is not bool:
+            raise ValueError
+    except Exception:
+        raise RuntimeError("CC collective selection unavailable or malformed") from None
+    return selected


