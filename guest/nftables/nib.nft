# SPDX-License-Identifier: Apache-2.0
# Candidate policy, not installed by P1 helpers. No flush of an existing ruleset.
# Sources and integration limits: ../README.md#network-policy
table inet nib {
    set egress4 {
        type ipv4_addr;
        # IPV4_ELEMENTS
    }
    set egress6 {
        type ipv6_addr;
        # IPV6_ELEMENTS
    }
    chain input {
        type filter hook input priority 0; policy drop;
        iifname "lo" accept
        ct state invalid drop
        ct state established,related accept
        tcp dport 8443 ct state new accept
    }
    chain forward {
        type filter hook forward priority 0; policy drop;
    }
    chain output {
        type filter hook output priority 0; policy drop;
        oifname "lo" accept
        ct state invalid drop
        ct state established,related accept
        ip daddr @egress4 tcp dport 443 ct state new accept
        ip6 daddr @egress6 tcp dport 443 ct state new accept
    }
}
