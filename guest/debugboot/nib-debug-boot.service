# SPDX-License-Identifier: Apache-2.0
# Carried from the debug initrd to /run. Never install in the production root.
[Unit]
Description=Debug root-switch and verity read probe
DefaultDependencies=no
Requires=systemd-udevd.service systemd-udev-trigger.service
After=systemd-udevd.service systemd-udev-trigger.service
SuccessAction=poweroff
FailureAction=poweroff

[Service]
Type=oneshot
ExecStart=/run/nib-debug-boot
TimeoutStartSec=150
TimeoutStopSec=2
KillMode=control-group
User=root
Group=root
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_SYS_ADMIN
RestrictAddressFamilies=AF_UNIX
LimitCORE=0
LimitFSIZE=0
MemoryMax=64M
TasksMax=32
UMask=0077
StandardInput=null
StandardOutput=null
StandardError=null
