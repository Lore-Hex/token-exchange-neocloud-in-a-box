{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.neocloud.invalid/nib/common.schema.json",
  "$comment": "SPDX-License-Identifier: Apache-2.0. Offline identifier, not a network endpoint.",
  "$defs": {
    "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$", "maxLength": 128},
    "packID": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*@[1-9][0-9]*$", "maxLength": 150},
    "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$", "minLength": 40, "maxLength": 40, "not": {"pattern": "^0{40}$"}},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$", "minLength": 64, "maxLength": 64, "not": {"pattern": "^0{64}$"}},
    "sha384": {"type": "string", "pattern": "^[0-9a-f]{96}$", "minLength": 96, "maxLength": 96, "not": {"pattern": "^0{96}$"}},
    "image": {
      "type": "string",
      "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*(:[1-9][0-9]*)?(/[a-z0-9]+([._-][a-z0-9]+)*)+@sha256:[0-9a-f]{64}$",
      "maxLength": 512,
      "not": {"pattern": "@sha256:0{64}$"},
      "description": "Repository plus SHA-256 digest, without a mutable tag."
    },
    "version": {"type": "string", "pattern": "^[0-9]+[.][0-9]+[.][0-9]+(-[0-9A-Za-z]+([.-][0-9A-Za-z]+)*)?$", "maxLength": 128},
    "text": {"type": "string", "minLength": 1, "pattern": "\\S", "maxLength": 4096},
    "utc": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,9})?Z$"},
    "path": {
      "type": "string", "maxLength": 1024,
      "pattern": "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$",
      "not": {"pattern": "(^|/)[.]{1,2}(/|$)"}
    },
    "args": {"type": "array", "items": {"$ref": "#/$defs/text"}, "maxItems": 256},
    "positive": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "fileEntry": {
      "type": "object", "additionalProperties": false, "required": ["sha256", "bytes", "path"],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "path": {"$ref": "#/$defs/path"}
      }
    }
  }
}
